datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  FARMER
  RETAILER
  SUPPLIER
  EXPERT
  DELIVERY
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum LicenseStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

model User {
  id           String          @id @default(uuid())
  phone        String          @unique
  email        String?         @unique
  name         String
  passwordHash String
  role         Role            @default(FARMER)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  farmer        FarmerProfile?
  retailer      RetailerProfile?
  supplier      SupplierProfile?
  expert        ExpertProfile?
  orders        Order[]
  cropScans     CropScan[]
  licenses      License[]
  soilReports   SoilReport[]
  posts         CommunityPost[]
  auditLogs     AuditLog[]
}

model FarmerProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  village      String?
  block        String?
  district     String
  landAreaAcre Decimal? @db.Decimal(10, 2)
  soilType     String?
  cropsGrown   String[]
}

model RetailerProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  shopName     String
  gstin        String?
  tradeLicense String?
  district     String
  verified     Boolean  @default(false)
}

model SupplierProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  companyName String
  district    String
  verified    Boolean  @default(false)
}

model ExpertProfile {
  id             String         @id @default(uuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id])
  qualification  String
  specialization String
  institution    String
  verified       Boolean        @default(true)
  consultations  Consultation[]
}

model Category {
  id        String    @id @default(uuid())
  slug      String    @unique
  nameEn    String
  nameBn    String
  products  Product[]
}

model Product {
  id                String       @id @default(uuid())
  slug              String       @unique
  nameEn            String
  nameBn            String
  brand             String
  categoryId        String
  category          Category     @relation(fields: [categoryId], references: [id])
  activeIngredients String?
  mrp               Decimal      @db.Decimal(12, 2)
  sellingPrice      Decimal      @db.Decimal(12, 2) // Farmer Retail Price
  retailerPrice     Decimal      @db.Decimal(12, 2) // Retailer Wholesale Price
  moq               Int          @default(1)
  licenseRequired   Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  stockBatches      StockBatch[]
  orderItems        OrderItem[]
  movements         StockMovement[]
}

model Warehouse {
  id        String       @id @default(uuid())
  code      String       @unique
  name      String
  district  String
  address   String
  batches   StockBatch[]
}

model StockBatch {
  id          String         @id @default(uuid())
  batchNumber String         @unique
  productId   String
  product     Product        @relation(fields: [productId], references: [id])
  warehouseId String?
  warehouse   Warehouse?     @relation(fields: [warehouseId], references: [id])
  quantity    Int
  mfgDate     DateTime
  expiryDate  DateTime // Crucial for FEFO (First Expiry, First Out)
  createdAt   DateTime       @default(now())
}

model StockMovement {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  batchNumber String
  quantity    Int
  reason      String   // DISPATCH, INWARD, DAMAGED, RECALL
  createdAt   DateTime @default(now())
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  isWholesale     Boolean     @default(false)
  subtotal        Decimal     @db.Decimal(12, 2)
  deliveryFee     Decimal     @db.Decimal(12, 2)
  totalAmount     Decimal     @db.Decimal(12, 2)
  status          OrderStatus @default(PLACED)
  deliveryOtp     String?
  shippingAddress Json
  paymentMethod   String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items           OrderItem[]
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
}

model License {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  licenseType   String
  licenseNumber String
  documentUrl   String
  expiryDate    DateTime
  status        LicenseStatus @default(PENDING)
  adminRemarks  String?
  createdAt     DateTime      @default(now())
}

model CropScan {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  cropName      String
  imageUrl      String
  diagnosis     String
  confidence    Decimal  @db.Decimal(5, 2)
  recommendedRx String?
  createdAt     DateTime @default(now())
}

model Consultation {
  id          String        @id @default(uuid())
  expertId    String
  expert      ExpertProfile @relation(fields: [expertId], references: [id])
  farmerName  String
  cropName    String
  query       String
  reply       String?
  status      String        @default("PENDING")
  createdAt   DateTime      @default(now())
}

model SoilReport {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  ph            Decimal  @db.Decimal(4, 2)
  organicCarbon Decimal  @db.Decimal(4, 2)
  nitrogen      Decimal  @db.Decimal(6, 2)
  phosphorus    Decimal  @db.Decimal(6, 2)
  potassium     Decimal  @db.Decimal(6, 2)
  zinc          Decimal? @db.Decimal(6, 2)
  boron         Decimal? @db.Decimal(6, 2)
  createdAt     DateTime @default(now())
}

model CommunityPost {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  content   String
  imageUrl  String?
  likes     Int      @default(0)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())
}
